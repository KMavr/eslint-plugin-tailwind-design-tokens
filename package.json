{
  "name": "eslint-plugin-tailwind-design-tokens",
  "version": "0.3.0",
  "description": "ESLint plugin that flags hardcoded colors and default Tailwind palette classes, steering you toward your design-system tokens.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tailwind",
    "tailwindcss",
    "design-tokens",
    "design-system",
    "colors"
  ],
  "homepage": "https://github.com/KMavr/eslint-plugin-tailwind-design-tokens#readme",
  "bugs": {
    "url": "https://github.com/KMavr/eslint-plugin-tailwind-design-tokens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KMavr/eslint-plugin-tailwind-design-tokens.git"
  },
  "license": "MIT",
  "author": "Konstantinos Mavrikas",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"if (process.env.CI) process.exit(0)\" && husky",
    "prepack": "npm run build && npm run lint && npm run typecheck && npm test -- --run",
    "doc": "npm run build && eslint-doc-generator && prettier --write README.md \"docs/rules/*.md\"",
    "doc:check": "npm run doc && git diff --exit-code -- README.md docs/rules"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.6.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
